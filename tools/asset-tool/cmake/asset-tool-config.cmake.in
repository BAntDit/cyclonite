@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(TinyGLTF REQUIRED)

# Provide path variables
set_and_check(asset-tool_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Include the targets file
if(NOT TARGET asset-tool::asset-tool-lib)
    include("${CMAKE_CURRENT_LIST_DIR}/asset-tool-targets.cmake")
endif()

if(NOT TARGET asset-tool::asset-tool-lib)
    add_library(asset-tool::asset-tool-lib ALIAS asset-tool-lib)
endif()

if(TARGET asset-tool::asset-tool-console)
    get_target_property(asset-tool_APP_LOCATION
        asset-tool::asset-tool-console LOCATION)
    set(asset-tool_APP "${asset-tool_APP_LOCATION}"
        CACHE FILEPATH "Path to asset-tool-console executable")
endif()

check_required_components(asset-tool)
