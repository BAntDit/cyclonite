@PACKAGE_INIT@

# Provide path variables
set_and_check(shader-compiler_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

include(CMakeFindDependencyMacro)
find_dependency(dxcompiler)
find_dependency(directx-headers)
find_dependency(Boost)
find_dependency(metrix)

# Include the targets file
if(NOT TARGET shader-compiler::shader-compiler-lib)
    include("${CMAKE_CURRENT_LIST_DIR}/shader-compiler-targets.cmake")
endif()

# Define modern CMake targets
if(NOT TARGET shader-compiler::shader-compiler-lib)
    add_library(shader-compiler::shader-compiler-lib ALIAS shader-compiler-lib)
endif()

check_required_components(shader-compiler)